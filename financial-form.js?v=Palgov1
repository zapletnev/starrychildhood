// Функция валидации email
function isValidEmail(email) {
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailRegex.test(email);
}

// Функция валидации телефона
function isValidPhone(phone) {
  const digits = phone.replace(/\D/g, "");
  return digits.length >= 10;
}

// Функция для показа ошибки
function showFieldError(field, message) {
  const wrapper = field.closest(".input-wrapper");
  let existingError = wrapper.querySelector(".field-error");
  if (existingError) {
    existingError.remove();
  }
  const errorMsg = document.createElement("div");
  errorMsg.className = "field-error";
  errorMsg.textContent = message;
  wrapper.classList.add("has-error");
  wrapper.appendChild(errorMsg);
  wrapper.classList.add("shake");
  setTimeout(() => {
    wrapper.classList.remove("shake");
  }, 500);
}

// Функция для очистки ошибки
function clearFieldError(field) {
  const wrapper = field.closest(".input-wrapper");
  const errorMsg = wrapper.querySelector(".field-error");
  if (errorMsg) {
    errorMsg.remove();
  }
  wrapper.classList.remove("has-error");
}

// Применение маски телефона
function applyPhoneMask(field) {
  field.addEventListener("input", function (e) {
    var x = e.target.value.replace(/\D/g, "").match(/(\d{0,1})(\d{0,3})(\d{0,3})(\d{0,2})(\d{0,2})/);
    e.target.value = !x[2] ? x[1] : "+" + x[1] + " (" + x[2] + ") " + (x[3] ? x[3] + "-" + x[4] : "") + (x[5] ? "-" + x[5] : "");
  });
}

// Инициализация маски для всех полей телефона
document.addEventListener("DOMContentLoaded", function () {
  const phoneInputs = document.querySelectorAll('input[type="tel"]');
  phoneInputs.forEach(input => {
    applyPhoneMask(input);
  });
});

// Основная форма: financialForm
const financialForm = document.getElementById("financialForm");
const phoneForm = document.getElementById("phoneForm");
const projectViewForm = document.getElementById("projectViewForm");

// reCAPTCHA removed: forms will post directly without requesting a grecaptcha token

// Обработка формы financialForm
if (financialForm) {
  const nameField = document.getElementById("financialName");
  const emailField = document.getElementById("financialEmail");
  const phoneField = document.getElementById("financialPhone");
  const cityField = document.getElementById("financialCity");

  // Валидация email
  if (emailField) {
    emailField.addEventListener("blur", function () {
      if (this.value && !isValidEmail(this.value)) {
        showFieldError(this, "Пожалуйста, введите корректный email");
      } else {
        clearFieldError(this);
      }
    });
    emailField.addEventListener("input", function () {
      if (this.value && isValidEmail(this.value)) {
        clearFieldError(this);
      }
    });
  }

  // Валидация телефона
  if (phoneField) {
    phoneField.addEventListener("blur", function () {
      if (this.value && !isValidPhone(this.value)) {
        showFieldError(this, "Пожалуйста, введите корректный номер телефона");
      } else {
        clearFieldError(this);
      }
    });
    applyPhoneMask(phoneField);
  }

  // Валидация имени и города
  [nameField, cityField].forEach((field) => {
    if (field) {
      field.addEventListener("blur", function () {
        if (!this.value) {
          showFieldError(this, "Это поле обязательно для заполнения");
        } else {
          clearFieldError(this);
        }
      });
      field.addEventListener("input", function () {
        if (this.value) {
          clearFieldError(this);
        }
      });
    }
  });

  // Отправка формы
  financialForm.addEventListener("submit", function (event) {
    event.preventDefault();

    let isFormValid = true;

    if (!nameField.value) {
      showFieldError(nameField, "Это поле обязательно для заполнения");
      isFormValid = false;
    }
    if (emailField.value && !isValidEmail(emailField.value)) {
      showFieldError(emailField, "Пожалуйста, введите корректный email");
      isFormValid = false;
    }
    if (!phoneField.value) {
      showFieldError(phoneField, "Это поле обязательно для заполнения");
      isFormValid = false;
    } else if (!isValidPhone(phoneField.value)) {
      showFieldError(phoneField, "Пожалуйста, введите корректный номер телефона");
      isFormValid = false;
    }
    if (cityField.value && !cityField.value.trim()) {
      showFieldError(cityField, "Это поле обязательно для заполнения");
      isFormValid = false;
    }

    if (!isFormValid) return;

    const submitBtn = this.querySelector(".submit-button");
    const originalBtnText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<span class="button-text">Отправка...</span>';
    submitBtn.disabled = true;
    submitBtn.classList.add("loading");

    // Submit form directly without reCAPTCHA token (server may still validate server-side)
    (function () {
      const formData = new FormData(financialForm);

      fetch("send.php", {
        method: "POST",
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        submitBtn.innerHTML = originalBtnText;
        submitBtn.disabled = false;
        submitBtn.classList.remove("loading");

        if (data.success) {
          closeFinancialForm();
          const formType = document.getElementById("formType").value;
          let message;
          switch (formType) {
            case 'catalog':
              message = "Ваш запрос на каталог успешно отправлен!";
              break;
            case 'request':
              message = "Ваша заявка на проект успешно отправлена!";
              break;
            case 'project_view':
              message = "Ваш запрос на просмотр полного проекта успешно отправлен!";
              break;
            case 'financial':
            default:
              message = "Ваша заявка на расчет финансовой модели успешно отправлена!";
              break;
          }
          showSuccessNotification(message);
          financialForm.reset();
        } else {
          alert("❌ Ошибка при отправке. Проверьте настройки сервера или попробуйте позже.");
        }
      })
      .catch((err) => {
        submitBtn.innerHTML = originalBtnText;
        submitBtn.disabled = false;
        submitBtn.classList.remove("loading");
        alert(`⚠ Произошла ошибка: ${err.message}`);
        console.error(err);
      });
    })();
  });
}

