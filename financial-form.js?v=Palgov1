// Инициализация после загрузки DOM
document.addEventListener("DOMContentLoaded", function () {
  const financialModal = document.getElementById("financialFormModal");
  const phoneModal = document.getElementById("phoneFormModal");
  const projectViewModal = document.getElementById("projectViewFormModal");

  const requestButton = document.getElementById("requestButton");
  if (requestButton) {
    requestButton.addEventListener("click", () => openFinancialForm('request'));
  } else {
    console.warn("Кнопка с id='requestButton' не найдена в DOM");
  }

  // Закрытие по клику вне контента
  if (financialModal) {
    financialModal.addEventListener("click", function (event) {
      if (event.target === financialModal) {
        closeFinancialForm();
      }
    });
  }
  if (phoneModal) {
    phoneModal.addEventListener("click", function (event) {
      if (event.target === phoneModal) {
        closePhoneForm();
      }
    });
  }
  if (projectViewModal) {
    projectViewModal.addEventListener("click", function (event) {
      if (event.target === projectViewModal) {
        closeProjectViewForm();
      }
    });
  }

  // Закрытие по клавише Escape
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") {
      if (financialModal && financialModal.classList.contains("active")) {
        closeFinancialForm();
      }
      if (phoneModal && phoneModal.classList.contains("active")) {
        closePhoneForm();
      }
      if (projectViewModal && projectViewModal.classList.contains("active")) {
        closeProjectViewForm();
      }
    }
  });
});