// Функция открытия модального окна финансовой формы
function openFinancialForm(formType = 'financial') {
  var modal = document.getElementById("financialFormModal");
  var financialFormTitle = document.getElementById("financialFormTitle");
  var financialFormDescription = document.getElementById("financialFormDescription");
  var financialSubmitBtn = document.getElementById("financialSubmitBtn");
  var formTypeInput = document.getElementById("formType");

  if (!modal || !financialFormTitle || !financialFormDescription || !financialSubmitBtn || !formTypeInput) {
    console.error("Не найдены необходимые элементы DOM:", {
      modal: !!modal,
      financialFormTitle: !!financialFormTitle,
      financialFormDescription: !!financialFormDescription,
      financialSubmitBtn: !!financialSubmitBtn,
      formTypeInput: !!formTypeInput
    });
    return;
  }

  let title, description, buttonText;
  switch (formType) {
    case 'catalog':
      title = 'Получить каталог';
      description = 'Заполните форму, чтобы получить каталог нашего оборудования';
      buttonText = 'Отправить запрос на каталог';
      break;
    case 'request':
      title = 'Отправить заявку';
      description = 'Заполните форму, чтобы отправить заявку на проект';
      buttonText = 'Отправить заявку';
      break;
    case 'project_view':
      title = 'Посмотреть полный проект';
      description = 'Заполните форму, чтобы получить доступ к полному проекту и дополнительным материалам';
      buttonText = 'Получить проект';
      break;
    case 'financial':
    default:
      title = 'Рассчитать финансовую модель';
      description = 'Заполните форму для получения расчета финансовой модели вашего проекта';
      buttonText = 'Рассчитать стоимость';
      break;
  }

  financialFormTitle.textContent = title;
  financialFormDescription.textContent = description;
  financialSubmitBtn.querySelector('.button-text').textContent = buttonText;
  formTypeInput.value = formType;
  modal.style.display = "flex";
  setTimeout(function () {
    modal.classList.add("active");
    document.body.style.overflow = "hidden";
  }, 10);
}

